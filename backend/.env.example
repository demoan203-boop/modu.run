NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# PostgreSQL 연결 문자열 (Supabase/Neon 등에서 발급). asyncpg 드라이버 사용:
# postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=

# openssl rand -hex 32 로 생성 권장
JWT_SECRET_KEY=

# 아래는 로컬 개발에서는 비워두고, 배포(Render) 환경변수에서만 설정합니다.
# CORS_ORIGINS=["https://modu.run","https://www.modu.run"]
# COOKIE_DOMAIN=.modu.run
# COOKIE_SECURE=true

# AI 가상 착용 (비워두면 mock 프로바이더로 항상 동작함)
VIRTUAL_TRY_ON_PROVIDER=mock
VIRTUAL_TRY_ON_API_URL=
VIRTUAL_TRY_ON_API_KEY=
VIRTUAL_TRY_ON_WEBHOOK_SECRET=
